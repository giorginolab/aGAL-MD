# tleap file generated by amber.build
source ff0_leaprc.protein.ff14SB
source ff1_leaprc.GLYCAM_06j-1
source ff2_leaprc.water.tip3p
source ff3_leaprc.gaff2

# Loading topologies
loadamberprep topo0_dgj.prepi

# Loading parameter files
loadamberparams param0_dgj.frcmod

# Loading the system
mol = loadpdb input.pdb

# Adding disulfide bonds
bond mol.22.SG mol.64.SG
bond mol.26.SG mol.33.SG
bond mol.112.SG mol.142.SG
bond mol.172.SG mol.193.SG
bond mol.348.SG mol.352.SG
bond mol.414.SG mol.456.SG
bond mol.418.SG mol.425.SG
bond mol.504.SG mol.534.SG
bond mol.564.SG mol.585.SG
bond mol.740.SG mol.744.SG

setBox mol "vdw"

# Writing out the results
saveamberparm mol structure.prmtop structure.crd
quit